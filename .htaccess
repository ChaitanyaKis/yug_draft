# Apache (needs mod_headers and mod_mime, and AllowOverride for this folder).
# The Content-Security-Policy value is filled in by scripts/build.py with the page's script hashes.
AddType application/manifest+json .webmanifest
AddType text/javascript .js
AddDefaultCharset utf-8

<IfModule mod_headers.c>
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-/x7W7R75k8Roq0WaVRQX9blP4OufE5xbAdzklGxsgpw='; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self' https://fonts.googleapis.com https://fonts.gstatic.com; manifest-src 'self'; worker-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
  Header set Cache-Control "no-cache"
  <FilesMatch "\.(png|jpe?g)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/manifest+json
</IfModule>

<IfModule mod_authz_core.c>
  <FilesMatch "^(_headers|vercel\.json)$">
    Require all denied
  </FilesMatch>
</IfModule>
